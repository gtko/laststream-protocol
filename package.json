{
  "name": "@laststream/protocol",
  "version": "0.2.0",
  "description": "Contrat partagé entre lastaddon (serveur) et laststream-app : watch party, synchro, épuration d'URL, langue des releases.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "gtko",
  "repository": { "type": "git", "url": "git+https://github.com/gtko/laststream-protocol.git" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./party": { "types": "./dist/party.d.ts", "default": "./dist/party.js" },
    "./sync": { "types": "./dist/sync.d.ts", "default": "./dist/sync.js" },
    "./scrub": { "types": "./dist/scrub.d.ts", "default": "./dist/scrub.js" },
    "./language": { "types": "./dist/language.d.ts", "default": "./dist/language.js" },
    "./social": { "types": "./dist/social.d.ts", "default": "./dist/social.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
